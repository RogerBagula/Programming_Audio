#!/usr/bin/env python3
"""
Fractal audio decompressor (.bl -> WAV) using PyTorch with MPS (Apple GPU) when available.

- Accepts .bl fractal files
- Uses GPU (MPS) on modern Macs if available
- Falls back to CPU otherwise
- Progress output
- Automatic save directory ~/FractalAudio/
"""

import os
import json
import numpy as np
import soundfile as sf
import traceback
from datetime import datetime

import torch


# ---------- Device selection ----------

def get_device():
    if torch.backends.mps.is_available():
        return torch.device("mps")
    elif torch.cuda.is_available():
        return torch.device("cuda")
    else:
        return torch.device("cpu")


# ---------- Logging ----------

LOG_DIR = os.path.expanduser("~/FractalAudio")
LOG_FILE = os.path.join(LOG_DIR, "decompress_mps_log.txt")

os.makedirs(LOG_DIR, exist_ok=True)

def log(msg):
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] {msg}"
    print(line)
    with open(LOG_FILE, "a") as f:
        f.write(line + "\n")


# ---------- Block maker ----------

def make_blocks(data, block_size):
    N = data.shape[1]
    blocks = []
    for start in range(0, N - block_size, block_size):
        blocks.append((start, data[:, start:start + block_size]))
    return blocks


# ---------- Fractal decompression (GPU-aware) ----------

def fractal_decompress_mps(bl_path, iterations=20):
    device = get_device()
    log(f"Using device: {device}")

    log(f"Loading fractal file: {bl_path}")
    with open(bl_path, "r") as f:
        bl = json.load(f)

    block_size = bl["block_size"]
    samplerate = bl["samplerate"]
    entries = bl["entries"]

    max_range = max(e["range_index"] for e in entries)
    data_length = (max_range + 1) * block_size

    log(f"Reconstructing {data_length} samples, block size {block_size}")
    log(f"Total entries: {len(entries)}")

    # Data on device
    data = torch.zeros((4, data_length), dtype=torch.float32, device=device)

    # Pre-pack entries as tensors
    range_indices = torch.tensor([e["range_index"] for e in entries], dtype=torch.int64)
    domain_indices = torch.tensor([e["domain_index"] for e in entries], dtype=torch.int64)
    As = torch.tensor([e["A"] for e in entries], dtype=torch.float32)      # [E, 4, 4]
    bs = torch.tensor([e["b"] for e in entries], dtype=torch.float32)      # [E, 4]

    As = As.to(device)
    bs = bs.to(device)
    range_indices = range_indices.to(device)
    domain_indices = domain_indices.to(device)

    for it in range(iterations):
        log(f"Iteration {it + 1} / {iterations}")

        # Build domains from current data (CPU -> GPU)
        blocks = make_blocks(data.cpu().numpy(), block_size * 2)
        domains_np = np.stack([blk for _, blk in blocks], axis=0)  # [D, 4, 2B]
        domains = torch.from_numpy(domains_np).to(device)          # [D, 4, 2B]
        domains_ds = domains[:, :, ::2]                            # [D, 4, B]

        E = len(entries)
        B = block_size

        # Gather domain blocks for each entry
        dom_blocks = domains_ds[domain_indices]                    # [E, 4, B]

        # Compute R_hat for all entries in batch
        R_hat = torch.bmm(As, dom_blocks) + bs.unsqueeze(2)        # [E, 4, B]

        # Write back into data
        for idx in range(E):
            r_idx = range_indices[idx].item()
            start = r_idx * block_size
            end = start + block_size
            if end <= data.shape[1]:
                data[:, start:end] = R_hat[idx]

            if idx % 200 == 0:
                log(f"Iteration {it + 1}: entry {idx + 1} / {E}")

    return data.cpu().numpy(), samplerate


# ---------- Save WAV ----------

def save_wav(path, data, samplerate):
    data = data.T  # (N, 4)
    sf.write(path, data, samplerate)
    log(f"Saved WAV file: {path}")


# ---------- Main ----------

def main():
    import tkinter as tk
    from tkinter import filedialog

    log("Fractal audio decompressor (MPS) started.")

    root = tk.Tk()
    root.withdraw()
    bl_file = filedialog.askopenfilename(
        title="Select .bl fractal file",
        filetypes=[("Fractal audio", "*.bl")]
    )

    if not bl_file:
        log("No .bl file selected. Exiting.")
        return

    try:
        data, sr = fractal_decompress_mps(bl_file, iterations=20)
    except Exception as e:
        log(f"Decompression error: {e}")
        log(traceback.format_exc())
        return

    base_name = os.path.splitext(os.path.basename(bl_file))[0]
    output_wav = os.path.join(LOG_DIR, base_name + "_reconstructed_mps.wav")

    save_wav(output_wav, data, sr)

    log("Done.")


if __name__ == "__main__":
    main()
