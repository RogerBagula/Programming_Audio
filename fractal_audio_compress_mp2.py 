#!/usr/bin/env python3
"""
Fractal audio compressor (MP3/WAV -> .bl) with:
A: Progress output
B: Crash logging
C: Automatic save directory ~/FractalAudio/
D: Multiprocessing for speed
E: Corrected tuple unpacking (fixes save crash)
"""

import os
import json
import numpy as np
from pydub import AudioSegment
from scipy.linalg import pinv
import multiprocessing as mp
import traceback
from datetime import datetime


# ---------- Logging ----------

LOG_DIR = os.path.expanduser("~/FractalAudio")
LOG_FILE = os.path.join(LOG_DIR, "compress_log.txt")

os.makedirs(LOG_DIR, exist_ok=True)

def log(msg):
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] {msg}"
    print(line)
    with open(LOG_FILE, "a") as f:
        f.write(line + "\n")


# ---------- Audio loading ----------

def load_audio_as_four_channel(path):
    audio = AudioSegment.from_file(path)
    samples = np.array(audio.get_array_of_samples()).astype(np.float32)
    channels = audio.channels
    samples = samples.reshape((-1, channels)).T  # (channels, N)

    if channels < 4:
        pad = np.zeros((4 - channels, samples.shape[1]), dtype=np.float32)
        samples = np.vstack([samples, pad])
    elif channels > 4:
        samples = samples[:4, :]

    return samples, audio.frame_rate


def make_blocks(data, block_size):
    N = data.shape[1]
    blocks = []
    for start in range(0, N - block_size, block_size):
        blocks.append(data[:, start:start + block_size])
    return blocks


# ---------- Affine map computation ----------

def compute_affine_map(R, D):
    A = R @ pinv(D)
    b = np.mean(R - A @ D, axis=1)
    return A, b


# ---------- Worker for multiprocessing ----------

def compress_range_block(args):
    idx_range, R, domains, block_size = args
    try:
        best_err = 1e99
        best = None

        for idx_dom, D_big in enumerate(domains):
            D = D_big[:, ::2]  # downsample

            A, b = compute_affine_map(R, D)
            R_hat = A @ D + b[:, None]
            err = np.mean((R - R_hat) ** 2)

            if err < best_err:
                best_err = err
                best = (idx_dom, A, b)

        return idx_range, best

    except Exception as e:
        log(f"Error in block {idx_range}: {e}")
        log(traceback.format_exc())
        return idx_range, None


# ---------- Fractal compression ----------

def fractal_compress_mp(data, block_size=1024, processes=None):
    ranges = make_blocks(data, block_size)
    domains = make_blocks(data, block_size * 2)

    if len(domains) == 0 or len(ranges) == 0:
        raise ValueError("Audio too short for given block_size.")

    log(f"Total range blocks: {len(ranges)}")
    log(f"Total domain blocks: {len(domains)}")

    args_list = [(i, R, domains, block_size) for i, R in enumerate(ranges)]

    if processes is None:
        processes = max(1, mp.cpu_count() - 1)

    log(f"Using {processes} processes for compression.")

    codebook = [None] * len(ranges)

    with mp.Pool(processes=processes) as pool:
        for idx_range, result in pool.imap_unordered(compress_range_block, args_list):
            codebook[idx_range] = (idx_range, result)

            if idx_range % 50 == 0:
                log(f"Progress: block {idx_range + 1} / {len(ranges)}")

    return codebook, block_size


# ---------- Save .bl file (FIXED) ----------

def save_bl(path, codebook, block_size, samplerate):
    serial = {
        "block_size": block_size,
        "samplerate": int(samplerate),
        "entries": []
    }

    for entry in codebook:
        if entry is None:
            continue

        # FIX: unpack nested tuple from multiprocessing
        range_idx, best = entry
        if best is None:
            continue

        dom_idx, A, b = best

        serial["entries"].append({
            "range_index": int(range_idx),
            "domain_index": int(dom_idx),
            "A": A.tolist(),
            "b": b.tolist()
        })

    with open(path, "w") as f:
        json.dump(serial, f)

    log(f"Saved .bl file: {path}")
    log(f"Total entries: {len(serial['entries'])}")


# ---------- Main ----------

def main():
    import tkinter as tk
    from tkinter import filedialog

    log("Fractal audio compressor started.")

    root = tk.Tk()
    root.withdraw()
    input_file = filedialog.askopenfilename(
        title="Select audio file",
        filetypes=[("Audio files", "*.mp3 *.wav")]
    )

    if not input_file:
        log("No input file selected. Exiting.")
        return

    log(f"Loading {input_file}...")
    data, sr = load_audio_as_four_channel(input_file)
    log(f"Sample rate: {sr}, channels: {data.shape[0]}, samples: {data.shape[1]}")

    try:
        log("Starting compression...")
        codebook, block_size = fractal_compress_mp(data, block_size=1024)
        log("Compression finished.")
    except Exception as e:
        log(f"Compression error: {e}")
        log(traceback.format_exc())
        return

    base_name = os.path.splitext(os.path.basename(input_file))[0]
    output_bl = os.path.join(LOG_DIR, base_name + ".bl")

    save_bl(output_bl, codebook, block_size, sr)

    log("Done.")


if __name__ == "__main__":
    main()
